  "exceptions": {
    "device_not_found": {
      "message": "Battery {address} not found. It may be asleep or out of range."
    },
    "switch_off_locked": {
      "message": "Switching off is locked for {entity}. Enable \"Allow switching off\" in the integration options first."
    },
    "switch_failed": {
      "message": "The battery accepted the command, but the MOSFET did not change state. A protection may be active."
    },
    "command_rejected": {
      "message": "The battery rejected the command."
    },
    "communication_error": {
      "message": "Communication with the battery failed: {error}"
    },
    "not_supported": {
      "message": "{address} has no TDT BMS (Bluetooth service FFF0 missing). WattCycle packs with JK or JBD BMS are not supported by this integration."
    }
  }
