{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "description": "Select the WattCycle battery to add.",
        "data": {
          "address": "Device"
        }
      },
      "bluetooth_confirm": {
        "description": "Do you want to set up {name}?"
      }
    },
    "abort": {
      "already_configured": "Device is already configured",
      "no_devices_found": "No WattCycle battery found. Make sure it is awake (apply a load or charge) and in Bluetooth range.",
      "not_supported": "Device is not a WattCycle battery with TDT BMS"
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "scan_interval": "Update interval",
          "keep_alive": "Keep connection open",
          "capacity_scale": "Capacity scaling",
          "allow_switch_off": "Allow switching off charge/discharge"
        },
        "data_description": {
          "keep_alive": "Faster and more stable, but occupies a Bluetooth connection slot permanently.",
          "capacity_scale": "Only change if capacities are off by a factor of 10.",
          "allow_switch_off": "On by default. Turn off to lock the switches against being switched off (switching on stays possible). Switching discharge off cuts the battery output, including a Home Assistant host powered by it."
        }
      }
    }
  },
  "selector": {
    "capacity_scale": {
      "options": {
        "auto": "Automatic (firmware)",
        "0.1": "0.1 Ah",
        "1": "1 Ah"
      }
    }
  },
